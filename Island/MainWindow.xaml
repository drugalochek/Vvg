<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moku" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Manual" Width="208" Height="60" WindowStartupLocation="Manual" Top="8" Left="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Жидкое стекло: градиентные карточки с бликом сверху и тонкой кромкой -->
        <LinearGradientBrush x:Key="Card" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#26FFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TabOn" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>

        <!-- Пружинка для наведения -->
        <BackEase x:Key="Spring" Amplitude="0.6" EasingMode="EaseOut"/>
        <CubicEase x:Key="Soft" EasingMode="EaseOut"/>

        <!-- Скроллбар Moku: узкая стеклянная капсула вместо стандартной белой полосы -->
        <Style x:Key="MokuScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#D9FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MokuScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MokuScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MokuScrollBar}"/>

        <Style x:Key="LanguagePill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="surface" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="surface" Property="BorderBrush" Value="#35FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="19" Background="{TemplateBinding Background}"/>
                            <Border x:Name="hv" CornerRadius="19" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#99FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="root" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="0.3"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource CardRim}" BorderThickness="1"/>
                            <Border x:Name="hv" CornerRadius="14" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки и переключатели: стеклянная «капля» у выбранного -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="15" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="13,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource TabOn}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Card}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Dim}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="6,0,0,0"
                        Content="&#xE8C8;" FontSize="13" ToolTip="Copy"
                        PreviewMouseLeftButtonUp="HistoryCopyButton_PreviewMouseLeftButtonUp"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="MokuSlider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="18" SnapsToDevicePixels="True">
                            <Border Height="2" VerticalAlignment="Center" CornerRadius="1" Background="#55FFFFFF"/>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" VerticalAlignment="Center" Background="#E6FFFFFF" CornerRadius="1"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" IsTabStop="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="knob" CornerRadius="5" Background="White" BorderBrush="#BFFFFFFF" BorderThickness="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="knob" Property="Background" Value="#FFE8E8E8"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Opacity="0">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource MokuSlider}"/>
        <Style x:Key="MokuInput" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="TextElement.Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#BFFFFFFF"/><Setter TargetName="surface" Property="Background" Value="#28FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Чисто чёрный остров с жидкой кромкой -->
    <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Width="184" Height="36"
            Margin="12,0,12,14" VerticalAlignment="Top" HorizontalAlignment="Center" MouseLeftButtonUp="Pill_Click">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings" x:Name="MenuSettings" Click="OpenSettings_Click"/>
                <Separator/>
                <MenuItem Header="Exit" x:Name="MenuExit" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Тело острова рисуется кодом: внизу «слаймовая» волна, пока играет музыка -->
            <Path x:Name="Body" IsHitTestVisible="False" Fill="#FF000000" StrokeThickness="1">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                        <GradientStop Color="#0FFFFFFF" Offset="0.45"/>
                        <GradientStop Color="#1AFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Мягкий блик сверху -->
            <Border Height="40" VerticalAlignment="Top" IsHitTestVisible="False"
                    CornerRadius="{Binding CornerRadius, ElementName=Pill}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0CFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Содержимое (обрезается по границам острова) -->
            <Grid ClipToBounds="True">
            <!-- Свёрнутый вид -->
            <Grid x:Name="Mini">
                <Grid x:Name="TimePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Глаза-овалы: следят за курсором, моргают, засыпают -->
                    <StackPanel x:Name="Eyes" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="EyeL" Width="6" Height="20" Fill="White" Margin="0,0,12,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyeLScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="EyeLRot" Angle="0"/>
                                    <TranslateTransform x:Name="EyeLShift"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="EyeR" Width="6" Height="20" Fill="White"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyeRScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="EyeRRot" Angle="0"/>
                                    <TranslateTransform x:Name="EyeRShift"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>

                    <!-- Compact media title: clipped to its own lane, never over the eyes or controls -->
                    <Grid x:Name="TitlePanel" Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center"
                          Visibility="Collapsed" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NoteIcon" Text="♪" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <Border x:Name="TitleViewport" Grid.Column="1" ClipToBounds="True" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <!-- Right lane: compact transport controls or clock/weather -->
                    <TextBlock x:Name="TimeText" Grid.Column="1" HorizontalAlignment="Center" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Grid Grid.Column="2" Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel x:Name="MiniMediaControls" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="MiniPrevBtn" Style="{StaticResource IconBtn}" Width="23" Height="23" Margin="0,0,1,0"
                                    FontSize="10" Content="&#xE892;" ToolTip="Previous" Click="MediaPrev_Click"/>
                            <Button x:Name="MiniPlayBtn" Style="{StaticResource IconBtn}" Width="23" Height="23" Margin="0,0,1,0"
                                    FontSize="10" Content="&#xE768;" ToolTip="Play / pause" Click="MediaPlay_Click"/>
                            <Button x:Name="MiniNextBtn" Style="{StaticResource IconBtn}" Width="23" Height="23" Margin="0"
                                    FontSize="10" Content="&#xE893;" ToolTip="Next" Click="MediaNext_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="WeatherDetails" Orientation="Horizontal" Visibility="Visible">
                            <Border x:Name="WeatherHost" Width="20" Height="20" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TempText" Foreground="{StaticResource Dim}" FontSize="12" FontWeight="SemiBold"
                                       Margin="3,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel x:Name="ToastPanel" Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="22,0">
                    <Ellipse x:Name="ToastDot" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock x:Name="ToastTitle" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="ToastSub" Foreground="{StaticResource Dim}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Раскрытый вид -->
            <Grid x:Name="Full" Visibility="Collapsed" Width="620" Height="316" Margin="16"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="FullShift" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabHome" Style="{StaticResource TabBtn}" Content="Home"
                                     Tag="Home" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabClip" Style="{StaticResource TabBtn}" Content="Clipboard"
                                     Tag="Clip" GroupName="tabs" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabApps" Style="{StaticResource TabBtn}" Content="Apps"
                                     Tag="Apps" GroupName="tabs" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSet" Style="{StaticResource TabBtn}" Content="Settings"
                                     Tag="Set" GroupName="tabs" Checked="Tab_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="FullClock" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="ExpandedWeatherHost" Width="20" Height="20" Margin="10,0,3,0"/>
                            <TextBlock x:Name="ExpandedTempText" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HotkeyHint" Text="Ctrl + Alt + Space" Foreground="#55FFFFFF" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Home -->
                <Grid x:Name="HomePage" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardRim}"
                                BorderThickness="1" CornerRadius="16" Padding="13,11">
                            <StackPanel>
                                <TextBlock x:Name="NowTitle" Text="Nothing playing" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NowArtist" Foreground="{StaticResource Dim}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MinHeight="16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="MediaPrev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;"
                                            Click="MediaPlay_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="MediaNext_Click"/>
                                    <Border Width="1" Background="#26FFFFFF" Margin="12,8"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74F;" Click="VolMute_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE993;" Click="VolDown_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE995;" Click="VolUp_Click"/>
                                </StackPanel>
                                <Grid Margin="2,5,2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SeekCurrentText" Text="0:00" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Slider Style="{StaticResource MokuSlider}" x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" PreviewKeyUp="SeekSlider_KeyUp"/>
                                    <TextBlock x:Name="SeekDurationText" Grid.Column="2" Text="0:00" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="RecentlyCopiedText" Grid.Row="1" Text="RECENTLY COPIED" Foreground="#66FFFFFF" FontSize="10"
                                   FontWeight="SemiBold" Margin="6,12,0,4"/>
                        <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Recent}" ItemContainerStyle="{StaticResource HistItem}"
                                 ItemTemplate="{StaticResource HistTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                    </Grid>

                    <UniformGrid x:Name="TileGrid" Grid.Column="1" Columns="2"/>
                </Grid>

                <!-- Буфер -->
                <Grid x:Name="ClipPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardRim}"
                                BorderThickness="1" CornerRadius="19" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}"
                                           Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White"
                                         CaretBrush="White" BorderThickness="0" Padding="0,9" FontSize="13"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;"
                                Margin="8,0,0,0" x:Name="ClearHistoryButton" ToolTip="Clear history" Click="ClearHistory_Click"/>
                    </Grid>
                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding HistoryView}" ItemContainerStyle="{StaticResource HistItem}"
                             ItemTemplate="{StaticResource HistTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                </Grid>

                <!-- Apps launcher -->
                <Grid x:Name="AppsPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="AppsHeading" Text="YOUR APPS" Foreground="White"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AppsHint" Text="Add your favorite apps for one-click launch."
                                       Foreground="#88FFFFFF" FontSize="11" Margin="0,3,0,0"/>
                            <Button x:Name="ScanSteamButton" Style="{StaticResource TileBtn}" Height="30" Width="154"
                                    HorizontalAlignment="Left" Margin="0,7,0,0" Click="ScanSteam_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ScanSteamText" Text="Find Steam games" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddAppButton" Style="{StaticResource TileBtn}"
                                    Height="34" Width="104" Margin="0" HorizontalAlignment="Right" Click="AddApp_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="AddAppText" Text="Add app" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <WrapPanel x:Name="SteamGamesGrid" Margin="0,0,4,6"/>
                            <WrapPanel x:Name="AppsGrid" Margin="0,0,4,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                  <StackPanel>
                    <Grid Margin="0,2,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" Text="Language" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="#17FFFFFF"
                                BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LanguageEnglish" Content="English" GroupName="language"
                                             Style="{StaticResource LanguagePill}" IsChecked="True" Checked="Language_Checked"/>
                                <RadioButton x:Name="LanguageRussian" Content="Русский" GroupName="language"
                                             Style="{StaticResource LanguagePill}" Checked="Language_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionLabel" Text="Position" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="AlignLeft" Style="{StaticResource TabBtn}" Content="Left"
                                         Tag="Left" GroupName="align" Checked="Align_Checked"/>
                            <RadioButton x:Name="AlignCenter" Style="{StaticResource TabBtn}" Content="Center"
                                         Tag="Center" GroupName="align" Checked="Align_Checked"/>
                            <RadioButton x:Name="AlignRight" Style="{StaticResource TabBtn}" Content="Right"
                                         Tag="Right" GroupName="align" Checked="Align_Checked"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="VerticalPositionLabel" Text="Vertical position" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="VerticalTop" Style="{StaticResource TabBtn}" Content="Top" Tag="Top" GroupName="vertical" Checked="VerticalAlign_Checked"/>
                            <RadioButton x:Name="VerticalCenter" Style="{StaticResource TabBtn}" Content="Center" Tag="Center" GroupName="vertical" Checked="VerticalAlign_Checked"/>
                            <RadioButton x:Name="VerticalBottom" Style="{StaticResource TabBtn}" Content="Bottom" Tag="Bottom" GroupName="vertical" Checked="VerticalAlign_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HorizontalOffsetLabel" Text="Horizontal offset" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="OffsetXInput" Style="{StaticResource MokuInput}" Text="0" ToolTip="Pixels from the selected horizontal position" LostFocus="OffsetXInput_LostFocus" KeyDown="OffsetInput_KeyDown"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TopOffsetLabel" Text="Vertical offset" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="OffsetYInput" Style="{StaticResource MokuInput}" Text="8" ToolTip="Pixels from the selected vertical position" LostFocus="OffsetYInput_LostFocus" KeyDown="OffsetInput_KeyDown"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="IslandSizeLabel" Text="Island size" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Width="28" Height="28" Click="Scale_Minus"/>
                                <TextBlock x:Name="ScaleText" Foreground="White" FontSize="12" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Width="28" Height="28" Click="Scale_Plus"/>
                            </DockPanel>
                            <Slider Style="{StaticResource MokuSlider}" x:Name="ScaleSlider" Minimum="70" Maximum="150" TickFrequency="5" ValueChanged="ScaleSlider_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AccentLabel" Text="Music and event color" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel x:Name="AccentPanel" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GlassOpacityLabel" Text="Island opacity" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Width="28" Height="28" Click="GlassOpacity_Minus"/>
                                <TextBlock x:Name="GlassOpacityText" Foreground="White" FontSize="12" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Width="28" Height="28" Click="GlassOpacity_Plus"/>
                            </DockPanel>
                            <Slider Style="{StaticResource MokuSlider}" x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="OpacitySlider_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FullscreenOpacityLabel" Text="Fullscreen opacity" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FullscreenOpacityText" Foreground="White" FontSize="12" Margin="0,0,0,3"/>
                            <Slider Style="{StaticResource MokuSlider}" x:Name="FullscreenOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="FullscreenOpacitySlider_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CornerRadiusLabel" Text="Corner rounding" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Width="28" Height="28" Click="Radius_Minus"/>
                                <TextBlock x:Name="RadiusText" Foreground="White" FontSize="12" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Width="28" Height="28" Click="Radius_Plus"/>
                            </DockPanel>
                            <Slider Style="{StaticResource MokuSlider}" x:Name="RadiusSlider" Minimum="0" Maximum="40" TickFrequency="1" ValueChanged="RadiusSlider_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ThemeLabel" Text="Theme" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeCombo" SelectedValuePath="Tag" SelectionChanged="Theme_Changed"
                                      Background="Transparent" Foreground="White" Height="38" BorderThickness="0"
                                      Padding="0" IsTextSearchEnabled="False">
                                <ComboBox.Resources>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="Foreground" Value="#F4F6FA"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="12,9"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#30FFFFFF"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#48FFFFFF"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="{x:Type ComboBox}">
                                        <Grid>
                                            <Border x:Name="themeSurface" Background="#24FFFFFF" BorderBrush="#66FFFFFF"
                                                    BorderThickness="1" CornerRadius="12"/>
                                            <Grid Margin="12,0,10,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                  TextElement.Foreground="White"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#CCFFFFFF" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ToggleButton Background="Transparent" BorderThickness="0"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Focusable="False" ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Border Background="Transparent" CornerRadius="12"/>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   PopupAnimation="Fade">
                                                <Border Background="#F0141B27" BorderBrush="#42FFFFFF"
                                                        BorderThickness="1" CornerRadius="13" Padding="6"
                                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ScrollViewer MaxHeight="240" CanContentScroll="True"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="themeSurface" Property="Background" Value="#38FFFFFF"/>
                                                <Setter TargetName="themeSurface" Property="BorderBrush" Value="#AAFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                <Setter TargetName="themeSurface" Property="Background" Value="#38FFFFFF"/>
                                                <Setter TargetName="themeSurface" Property="BorderBrush" Value="#CCFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="themeSurface" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ComboBox.Template>
                                <ComboBoxItem Content="Midnight" Tag="Midnight"/>
                                <ComboBoxItem Content="Ocean" Tag="Ocean"/>
                                <ComboBoxItem Content="Amethyst" Tag="Amethyst"/>
                                <ComboBoxItem Content="Emerald" Tag="Emerald"/>
                                <ComboBoxItem Content="Rose" Tag="Rose"/>
                                <ComboBoxItem Content="Custom color" Tag="Custom"/>
                            </ComboBox>

                        </Grid>
                    </Grid>
                    <StackPanel Margin="0,2,0,12">
                        <TextBlock x:Name="GradientColorsLabel" Text="Island gradient colors" Foreground="White" FontSize="13" Margin="0,0,0,7"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="TopGradientColorButton" Style="{StaticResource TileBtn}" Height="36" Width="154"
                                    Margin="0,0,8,0" Click="TopGradientColor_Click" Content="Upper color"/>
                            <Button x:Name="BottomGradientColorButton" Style="{StaticResource TileBtn}" Height="36" Width="154"
                                    Margin="0" Click="BottomGradientColor_Click" Content="Lower color"/>
                        </StackPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="GradientBalanceText" Text="70%" Foreground="#CCFFFFFF" FontSize="12"
                                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock x:Name="GradientBalanceLabel" Text="Color balance" Foreground="#BFFFFFFF"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="GradientBalanceSlider" Style="{StaticResource MokuSlider}"
                                Minimum="10" Maximum="90" TickFrequency="5"
                                ValueChanged="GradientBalanceSlider_Changed"/>
                    </StackPanel>
                    <!-- v2.7: расширенные настройки (строятся кодом, MainWindow.SettingsExtra.cs) -->
                    <StackPanel x:Name="ExtraSettingsPanel" Margin="0,0,0,12"/>

                    <Button x:Name="AutoBtn" Style="{StaticResource TileBtn}" Height="38" Width="230"
                            HorizontalAlignment="Left" Margin="0" Click="AutoBtn_Click"/>

                    <Button x:Name="SupportBtn" Style="{StaticResource TileBtn}" Height="38" Width="230"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="SupportAuthor_Click"/>

                    <TextBlock x:Name="AccentDescription" Text="Glass appearance with subtle white highlights and adjustable color."
                               Foreground="#66FFFFFF" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </ScrollViewer>
            </Grid>

            </Grid>

            <!-- Волна по нижнему краю: цвет акцента + свечение -->
            <Path x:Name="Wave" IsHitTestVisible="False" StrokeThickness="2" Visibility="Collapsed"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Border>
</Window>
