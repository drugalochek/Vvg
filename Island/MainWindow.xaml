<Window x:Class="Island.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moku" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Manual" Width="208" Height="60" WindowStartupLocation="Manual" Top="8" Left="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Жидкое стекло: градиентные карточки с бликом сверху и тонкой кромкой -->
        <LinearGradientBrush x:Key="Card" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#26FFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TabOn" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#1FFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>

        <!-- Пружинка для наведения -->
        <BackEase x:Key="Spring" Amplitude="0.6" EasingMode="EaseOut"/>
        <CubicEase x:Key="Soft" EasingMode="EaseOut"/>

        <Style x:Key="LanguagePill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="surface" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="surface" Property="BorderBrush" Value="#35FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="19" Background="{TemplateBinding Background}"/>
                            <Border x:Name="hv" CornerRadius="19" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#99FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="root" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="0.3"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource CardRim}" BorderThickness="1"/>
                            <Border x:Name="hv" CornerRadius="14" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hv" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки и переключатели: стеклянная «капля» у выбранного -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="15" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="13,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource TabOn}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Card}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HistTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Time}" Foreground="{StaticResource Dim}" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Чисто чёрный остров с жидкой кромкой -->
    <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Width="184" Height="36"
            Margin="12,0,12,14" VerticalAlignment="Top" HorizontalAlignment="Center" MouseLeftButtonUp="Pill_Click">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings" x:Name="MenuSettings" Click="OpenSettings_Click"/>
                <Separator/>
                <MenuItem Header="Exit" x:Name="MenuExit" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Тело острова рисуется кодом: внизу «слаймовая» волна, пока играет музыка -->
            <Path x:Name="Body" IsHitTestVisible="False" Fill="#FF000000" StrokeThickness="1">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                        <GradientStop Color="#0FFFFFFF" Offset="0.45"/>
                        <GradientStop Color="#1AFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>

            <!-- Мягкий блик сверху -->
            <Border Height="40" VerticalAlignment="Top" IsHitTestVisible="False"
                    CornerRadius="{Binding CornerRadius, ElementName=Pill}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0CFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Содержимое (обрезается по границам острова) -->
            <Grid ClipToBounds="True">
            <!-- Свёрнутый вид -->
            <Grid x:Name="Mini">
                <Grid x:Name="TimePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Глаза-овалы: следят за курсором, моргают, засыпают -->
                    <StackPanel x:Name="Eyes" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="EyeL" Width="6" Height="20" Fill="White" Margin="0,0,12,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyeLScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="EyeLShift"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="EyeR" Width="6" Height="20" Fill="White"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="EyeRScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="EyeRShift"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>

                    <!-- Что играет (только когда идёт музыка) -->
                    <Grid x:Name="TitlePanel" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NoteIcon" Text="♪" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="White" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Right: время и погода -->
                    <TextBlock x:Name="TimeText" Grid.ColumnSpan="3" HorizontalAlignment="Center" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,13,0" VerticalAlignment="Center">
                        
                        <Border x:Name="WeatherHost" Width="20" Height="20" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TempText" Foreground="{StaticResource Dim}" FontSize="12" FontWeight="SemiBold"
                                   Margin="3,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ToastPanel" Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="22,0">
                    <Ellipse x:Name="ToastDot" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock x:Name="ToastTitle" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="ToastSub" Foreground="{StaticResource Dim}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Раскрытый вид -->
            <Grid x:Name="Full" Visibility="Collapsed" Width="620" Height="316" Margin="16"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="FullShift" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabHome" Style="{StaticResource TabBtn}" Content="Home"
                                     Tag="Home" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabClip" Style="{StaticResource TabBtn}" Content="Clipboard"
                                     Tag="Clip" GroupName="tabs" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSet" Style="{StaticResource TabBtn}" Content="Settings"
                                     Tag="Set" GroupName="tabs" Checked="Tab_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FullClock" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Alt + Space" Foreground="#55FFFFFF" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Home -->
                <Grid x:Name="HomePage" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardRim}"
                                BorderThickness="1" CornerRadius="16" Padding="13,11">
                            <StackPanel>
                                <TextBlock x:Name="NowTitle" Text="Nothing playing" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NowArtist" Foreground="{StaticResource Dim}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MinHeight="16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="MediaPrev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;"
                                            Click="MediaPlay_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="MediaNext_Click"/>
                                    <Border Width="1" Background="#26FFFFFF" Margin="12,8"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74F;" Click="VolMute_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE993;" Click="VolDown_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE995;" Click="VolUp_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="RecentlyCopiedText" Grid.Row="1" Text="RECENTLY COPIED" Foreground="#66FFFFFF" FontSize="10"
                                   FontWeight="SemiBold" Margin="6,12,0,4"/>
                        <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Recent}" ItemContainerStyle="{StaticResource HistItem}"
                                 ItemTemplate="{StaticResource HistTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                    </Grid>

                    <UniformGrid x:Name="TileGrid" Grid.Column="1" Columns="2"/>
                </Grid>

                <!-- Буфер -->
                <Grid x:Name="ClipPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardRim}"
                                BorderThickness="1" CornerRadius="19" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}"
                                           Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White"
                                         CaretBrush="White" BorderThickness="0" Padding="0,9" FontSize="13"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;"
                                Margin="8,0,0,0" x:Name="ClearHistoryButton" ToolTip="Clear history" Click="ClearHistory_Click"/>
                    </Grid>
                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding HistoryView}" ItemContainerStyle="{StaticResource HistItem}"
                             ItemTemplate="{StaticResource HistTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                </Grid>

                <!-- Settings -->
                <StackPanel x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid Margin="0,2,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" Text="Language" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="#17FFFFFF"
                                BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LanguageEnglish" Content="English" GroupName="language"
                                             Style="{StaticResource LanguagePill}" IsChecked="True" Checked="Language_Checked"/>
                                <RadioButton x:Name="LanguageRussian" Content="Русский" GroupName="language"
                                             Style="{StaticResource LanguagePill}" Checked="Language_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionLabel" Text="Position" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="AlignLeft" Style="{StaticResource TabBtn}" Content="Left"
                                         Tag="Left" GroupName="align" Checked="Align_Checked"/>
                            <RadioButton x:Name="AlignCenter" Style="{StaticResource TabBtn}" Content="Center"
                                         Tag="Center" GroupName="align" Checked="Align_Checked"/>
                            <RadioButton x:Name="AlignRight" Style="{StaticResource TabBtn}" Content="Right"
                                         Tag="Right" GroupName="align" Checked="Align_Checked"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TopOffsetLabel" Text="Top offset" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Click="Offset_Minus"/>
                            <TextBlock x:Name="OffsetText" Foreground="White" FontSize="13" Width="64"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Click="Offset_Plus"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IslandSizeLabel" Text="Island size" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Click="Scale_Minus"/>
                            <TextBlock x:Name="ScaleText" Foreground="White" FontSize="13" Width="64"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Click="Scale_Plus"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AccentLabel" Text="Music and event color" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel x:Name="AccentPanel" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="AutoBtn" Style="{StaticResource TileBtn}" Height="38" Width="230"
                            HorizontalAlignment="Left" Margin="0" Click="AutoBtn_Click"/>

                    <TextBlock x:Name="AccentDescription" Text="The island stays black — color appears only when music is playing or an event occurs."
                               Foreground="#66FFFFFF" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            </Grid>

            <!-- Волна по нижнему краю: цвет акцента + свечение -->
            <Path x:Name="Wave" IsHitTestVisible="False" StrokeThickness="2" Visibility="Collapsed"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Border>
</Window>
