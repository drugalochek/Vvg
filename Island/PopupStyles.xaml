<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <CornerRadius x:Key="MokuPopupRadius">18</CornerRadius>
        <CornerRadius x:Key="MokuPopupItemRadius">10</CornerRadius>
        <LinearGradientBrush x:Key="MokuPopupSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF18181D" Offset="0"/>
            <GradientStop Color="#FF09090C" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MokuPopupRim" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="MokuPopupHover" Color="#1FFFFFFF"/>

        <Style x:Key="MokuMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource MokuPopupItemRadius}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="21"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" FontSize="16" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource MokuPopupSurface}" BorderBrush="{DynamicResource MokuPopupRim}"
                                        BorderThickness="1" CornerRadius="{DynamicResource MokuPopupRadius}" Padding="6" MinWidth="190" MaxHeight="520">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource MokuPopupHover}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource MokuPopupHover}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource MokuMenuItem}"/>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#20FFFFFF"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MokuContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="Background" Value="{DynamicResource MokuPopupSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MokuPopupRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource MokuPopupRadius}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource MokuContextMenu}"/>
        <Style x:Key="MokuWindowTooltip" TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource MokuPopupSurface}" BorderBrush="{DynamicResource MokuPopupRim}"
                                BorderThickness="1" CornerRadius="{DynamicResource MokuPopupRadius}" Padding="10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
