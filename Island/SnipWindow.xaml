<Window x:Class="Island.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Snip" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="Cross" WindowStartupLocation="Manual" Left="0" Top="0"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Display, Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="TB" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="hv" CornerRadius="9" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="0.16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TR" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="9" Background="Transparent" Padding="10,0" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3DFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Что попадёт в итоговую картинку: снимок + рисунки -->
        <Grid x:Name="Stage">
            <Image x:Name="Bg" Stretch="Fill"/>
            <Canvas x:Name="Ink"/>
        </Grid>

        <!-- Затемнение, рамка, панель инструментов -->
        <Canvas x:Name="Overlay" Background="Transparent"
                MouseLeftButtonDown="Overlay_Down" MouseMove="Overlay_Move" MouseLeftButtonUp="Overlay_Up">
            <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" Visibility="Collapsed"
                       IsHitTestVisible="False"/>
            <Border x:Name="Badge" Background="#D9000000" CornerRadius="5" Padding="7,2"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11"/>
            </Border>

            <Border x:Name="Toolbar" Background="#F2000000" CornerRadius="13" Padding="6"
                    Visibility="Collapsed" MouseLeftButtonDown="Toolbar_Swallow">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TR}" x:Name="PenTool" Content="Pen" Tag="Pen" GroupName="tool"
                                 IsChecked="True" Checked="Tool_Checked"/>
                    <RadioButton Style="{StaticResource TR}" x:Name="ArrowTool" Content="Arrow" Tag="Arrow" GroupName="tool"
                                 Checked="Tool_Checked"/>
                    <RadioButton Style="{StaticResource TR}" x:Name="RectangleTool" Content="Rectangle" Tag="Rect" GroupName="tool"
                                 Checked="Tool_Checked"/>
                    <RadioButton Style="{StaticResource TR}" x:Name="HighlighterTool" Content="Highlighter" Tag="Marker" GroupName="tool"
                                 Checked="Tool_Checked"/>
                    <Border Width="1" Background="#33FFFFFF" Margin="8,6"/>
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="ThickBtn" Style="{StaticResource TB}" Width="44" FontFamily="Segoe UI"
                            FontSize="12" Click="Thick_Click" ToolTip="Thickness"/>
                    <Border Width="1" Background="#33FFFFFF" Margin="8,6"/>
                    <Button Style="{StaticResource TB}" Content="&#xE7A7;" x:Name="UndoButton" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
                    <Button Style="{StaticResource TB}" Content="&#xE74E;" x:Name="SaveButton" ToolTip="Save (Ctrl+S)" Click="Save_Click"/>
                    <Button Style="{StaticResource TB}" Content="&#xE8C8;" x:Name="CopyButton" ToolTip="Copy (Enter)" Click="Copy_Click"/>
                    <Button Style="{StaticResource TB}" Content="&#xE711;" x:Name="CloseButton" ToolTip="Close (Esc)" Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Canvas>

        <TextBlock x:Name="Hint" Text="Select a screen area  ·  Esc — cancel" Foreground="White" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</Window>
