<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Moku-Setup</AssemblyName>
    <Version>2.12.3</Version>
    <AssemblyVersion>2.12.3.0</AssemblyVersion>
    <FileVersion>2.12.3.0</FileVersion>
    <InformationalVersion>2.12.3</InformationalVersion>
    <RootNamespace>MokuInstaller</RootNamespace>
    <ApplicationIcon>..\Island\Moku.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- build-release.bat publishes Island first; embed that exact self-contained executable -->
    <EmbeddedResource Include="..\Island\publish\Moku.exe" LogicalName="MokuInstaller.Payload.Moku.exe" />
    <EmbeddedResource Include="..\Island\Moku.ico" LogicalName="MokuInstaller.Payload.Moku.ico" />
  </ItemGroup>
</Project>
